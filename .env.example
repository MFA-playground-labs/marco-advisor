NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=
MARCO_BASE_URL=
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
OPENAI_ADVISOR_MODEL=gpt-4.1-mini

# Async extraction worker. Extraction is n8n-first; OpenAI is for Marco chat only.
N8N_EXTRACTION_WEBHOOK_URL=
N8N_EXTRACTION_TEST_WEBHOOK_URL=https://marco-advisor.app.n8n.cloud/webhook-test/f02c9c49-a8c5-46f2-880d-aab36bb7304c
EXTRACTION_WEBHOOK_SECRET=
EXTRACTION_PROVIDER=n8n
EXTRACTION_FALLBACK_MODEL=claude-haiku
EXTRACTION_CONFIDENCE_THRESHOLD=0.85
EXTRACTION_MAX_PAGES=10
EXTRACTION_MAX_TEXT_CHARS=25000
E2E_ACCEPT_CANDIDATE=true
E2E_TIMEOUT_MS=180000

# Legacy Supabase projects may call this the anon key. The app supports either key name.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: only needed for future admin/server-only jobs.
SUPABASE_SERVICE_ROLE_KEY=

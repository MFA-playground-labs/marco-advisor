NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=
MARCO_BASE_URL=
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
OPENAI_ADVISOR_MODEL=gpt-4.1-mini

# Async OpenAI extraction worker.
EXTRACTION_RUN_SECRET=
OPENAI_EXTRACTION_MAX_ENCODED_BYTES=20971520
EXTRACTION_STALE_PROCESSING_MS=900000
EXTRACTION_CONFIDENCE_THRESHOLD=0.85
EXTRACTION_MAX_PAGES=10
EXTRACTION_MAX_TEXT_CHARS=25000
E2E_ACCEPT_CANDIDATE=true
E2E_TIMEOUT_MS=180000

# Legacy Supabase projects may call this the anon key. The app supports either key name.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for server-only OpenAI extraction jobs.
SUPABASE_SERVICE_ROLE_KEY=
